DATABASE_URL=file:./data/leadhunter.db

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_MONTHLY_BUDGET_USD=10

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

EMAIL_SENDING_ENABLED=false
MAX_EMAILS_PER_DAY=30
MIN_SECONDS_BETWEEN_EMAILS=60

GOOGLE_PLACES_API_KEY=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
APP_TIMEZONE=America/Bahia

# Instagram — primeiro contato pelo SEU Chrome (perfil dedicado, porta de debug só em 127.0.0.1)
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile
INSTAGRAM_DM_ENABLED=false
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Bahia

# Instagram — continuação da conversa pela API oficial da Meta (webhook)
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v21.0

# Autopilot (observar → decidir → agir → medir → aprender). Só age quando não está pausado.
AUTOPILOT_ENABLED=false

# WhatsApp opcional: pasta de fila de um listener externo (um JSON por mensagem)
WHATSAPP_QUEUE_DIR=
